[gd_resource type="Resource" script_class="BuildingData" format=3]

[ext_resource type="Script" path="res://scripts/data/building_data.gd" id="1_bd"]

[resource]
script = ExtResource("1_bd")
id = &"kitchen"
display_name = "Cozinha"
description = "Cozinha a comida: rende mais (menos consumo) e a refeição quente levanta a moral."
category = 1
costs = Array[Dictionary]([{
"energy": 3,
"scrap": 12
}, {
"components": 3,
"scrap": 25
}])
required_workshop = PackedInt32Array(0, 1)
effect_values = PackedFloat32Array(0, 1, 2)
effect_format = "-%d comida no consumo diário"
