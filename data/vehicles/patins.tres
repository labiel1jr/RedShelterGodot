[gd_resource type="Resource" script_class="VehicleData" format=3]

[ext_resource type="Script" path="res://scripts/data/vehicle_data.gd" id="1_vd"]

[resource]
script = ExtResource("1_vd")
id = &"patins"
display_name = "Patins"
color = Color(0.25, 0.75, 0.95, 1)
max_hp = 40
duration = 20.0
hint = "PATINS: pulo mais alto e troca de faixa rápida. Um agarrão quebra os patins."
speed_multiplier = 1.15
jump_multiplier = 1.6
lane_speed_multiplier = 1.3
contact_damage = 10
grab_breaks = true
regions = Array[StringName]([&"bairro", &"centro"])
